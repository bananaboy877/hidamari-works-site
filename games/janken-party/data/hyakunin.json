      "lines": [
        "おもいわび",
        "さてもいのちは",
        "あるものを",
        "うきにたえぬは",
        "なみだなりけり"
      ]
    },
    {
      "number": 83,
      "author": "皇太后宮大夫俊成",
      "lines": [
        "よのなかよ",
        "みちこそなけれ",
        "おもいいる",
        "やまのおくにも",
        "しかぞなくなる"
      ]
    },
    {
      "number": 84,
      "author": "藤原清輔朝臣",
      "lines": [
        "ながらえば",
        "またこのごろや",
        "しのばれむ",
        "うしとみしよぞ",
        "いまはこいしき"
      ]
    },
    {
      "number": 85,
      "author": "俊恵法師",
      "lines": [
        "よもすがら",
        "ものおもうころは",
        "あけやらぬ",
        "ねやのひまさえ",
        "つれなかりけり"
      ]
    },
    {
      "number": 86,
      "author": "西行法師",
      "lines": [
        "なげけとて",
        "つきやはものを",
        "おもわする",
        "かこちがおなる",
        "わがなみだかな"
      ]
    },
    {
      "number": 87,
      "author": "寂蓮法師",
      "lines": [
        "むらさめの",
        "つゆもまだひぬ",
        "まきのはに",
        "きりたちのぼる",
        "あきのゆうぐれ"
      ]
    },
    {
      "number": 88,
      "author": "皇嘉門院別当",
      "lines": [
        "なにわえの",
        "あしのかりねの",
        "ひとよゆえ",
        "みをつくしてや",
        "こいわたるべき"
      ]
    },
    {
      "number": 89,
      "author": "式子内親王",
      "lines": [
        "たまのおよ",
        "たえなばたえね",
        "ながらえば",
        "しのぶることの",
        "よわりもぞする"
      ]
    },
    {
      "number": 90,
      "author": "殷富門院大輔",
      "lines": [
        "みせばやな",
        "おじまのあまの",
        "そでだにも",
        "ぬれにぞぬれし",
        "いろはかわらず"
      ]
    },
    {
      "number": 91,
      "author": "後京極摂政前太政大臣",
      "lines": [
        "きりぎりす",
        "なくやしもよの",
        "さむしろに",
        "ころもかたしき",
        "ひとりかもねむ"
      ]
    },
    {
      "number": 92,
      "author": "二条院讃岐",
      "lines": [
        "わがそでは",
        "しおひにみえぬ",
        "おきのいしの",
        "ひとこそしらね",
        "かわくまもなし"
      ]
    },
    {
      "number": 93,
      "author": "鎌倉右大臣",
      "lines": [
        "よのなかは",
        "つねにもがもな",
        "なぎさこぐ",
        "あまのおぶねの",
        "つなでかなしも"
      ]
    },
    {
      "number": 94,
      "author": "参議雅経",
      "lines": [
        "みよしのの",
        "やまのあきかぜ",
        "さよふけて",
        "ふるさとさむく",
        "ころもうつなり"
      ]
    },
    {
      "number": 95,
      "author": "前大僧正慈円",
      "lines": [
        "おおけなく",
        "うきよのたみに",
        "おおうかな",
        "わがたつそまに",
        "すみぞめのそで"
      ]
    },
    {
      "number": 96,
      "author": "入道前太政大臣",
      "lines": [
        "はなさそう",
        "あらしのにわの",
        "ゆきならで",
        "ふりゆくものは",
        "わがみなりけり"
      ]
    },
    {
      "number": 97,
      "author": "権中納言定家",
      "lines": [
        "こぬひとを",
        "まつほのうらの",
        "ゆうなぎに",
        "やくやもしおの",
        "みもこがれつつ"
      ]
    },
    {
      "number": 98,
      "author": "従二位家隆",
      "lines": [
        "かぜそよぐ",
        "ならのおがわの",
        "ゆうぐれは",
        "みそぎぞなつの",
        "しるしなりける"
      ]
    },
    {
      "number": 99,
      "author": "後鳥羽院",
      "lines": [
        "ひともおし",
        "ひともうらめし",
        "あじきなく",
        "よをおもうゆえに",
        "ものおもうみは"
      ]
    },
    {
      "number": 100,
      "author": "順徳院",
      "lines": [
        "ももしきや",
        "ふるきのきばの",
        "しのぶにも",
        "なおあまりある",
        "むかしなりけり"
      ]
    }
  ]
}